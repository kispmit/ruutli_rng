  // Ülesanded: 2 "mine tee midagi" + 1 tingimus selle kohta, kuidas koju jõuad (+ mis telefoni teel lisandub).
  // "final" ülesandeid kontrollitakse alles kodus (ekraanil näitab vahepeal GRAAFIKUS / RIVIST VÄLJAS).
  "task_groups": [
    { "count": 2, "pool": ["kebab_home", "martin_owes", "full_set", "all_venues", "win_fight", "get_number",
                           "six_drinks", "squad", "tristan_home", "whole_gig", "nuclear", "side_four"] },
    { "count": 1, "pool": ["cash_50", "battery_40", "no_blackout", "early_home", "no_taxi"],
      "weights": { "early_home": 0.35 } }
  ],

  // Kõrvalülesanded tulevad terve öö telefoni (max_active korraga lahti). Põhiülesanded = need, mis said alguses.
  "side_quests": {
    "first_at": "00:12",
    "every": [15, 25],
    "max_active": 4,
    "pool": [
      { "task": "sq_dance",      "from": "Ain",       "text": "SEIK. TANTSUPÕRAND. KOHE. ma ootan", "if": [{ "before": "05:00" }] },
      { "task": "sq_gig",        "from": "Tristan",   "text": "bro gennis on bänd. nad on sitad. nad on PARIMAD. tule vaata asap", "if": [{ "var": "gig_sets", "<": 2 }, { "before": "04:30" }] },
      { "task": "sq_charge",     "from": "Kardo",     "text": "lae oma telefon vähemalt 70% peale. ma tahan hommikul teada, et sa elus oled" },
      { "task": "sq_chill",      "from": "Kardo",     "text": "ma näen su storyst, et sa oled liiga kõrgel. jahtu maha. probleem alla 20. see on käsk", "if": [{ "var": "problem", ">": 30 }] },
      { "task": "sq_toome",      "from": "Jasper",    "text": "lähme toomele. sealt näeb mu ehitust. tule ka", "if": [{ "not_visited": "toomemagi" }],
        "replies": [{ "label": "Lähme! (kõnnin kohe)", "do": [{ "aff": { "jasper": 1 } }, { "walk_to": "toomemagi" }, { "say": "Jasper on juba üleval ja osutab pimedusse: „Seal. See kraana. See on minu oma.“ Ta ei ole tema oma. Aga ta ehitab selle all." }] },
                     { "label": "Hiljem", "do": [] }] },
      { "task": "sq_river",      "from": "Jasper",    "text": "truuse väidab jälle et emajõgi voolab täna tagurpidi. lähme kontrollime voolusuunda. ehitusmehena mul on vesilood kaasas", "if": [{ "not_visited": "emajogi" }],
        "replies": [{ "label": "Lähme kontrollime!", "do": [{ "aff": { "jasper": 1 } }, { "walk_to": "emajogi" }, { "log": "Käisid Jasperiga Emajõe voolusuunda kontrollimas." }, { "say": "Jasper paneb vesiloodi kaldale ja vaatab mullikest. Siis vett. Siis mullikest. „Õigetpidi. Truuse eksis.“ Ta teeb sellest pildi tõendiks." }] },
                     { "label": "Hiljem", "do": [] }] },
      { "task": "sq_raekoja",    "from": "Kaarna",    "text": "palun mine raekoja platsile ja saada pilt suudlevatest tudengitest. truuse ütleb et nad liiguvad. tahan tõestada et ei liigu", "if": [{ "not_visited": "raekoja" }],
        "replies": [{ "label": "Lähen kohe", "do": [{ "aff": { "kaarna": 1 } }, { "walk_to": "raekoja" }, { "say": "Teed pildi. Tudengid ei liigu. Kaarna vastab ühe sõnaga: „AITÄH.“" }] },
                     { "label": "Hiljem", "do": [] }] },
      { "task": "sq_kebab",      "from": "Martin",    "text": "has on täna eriti hea, ausalt. sa pead seda sööma. trust me", "if": [{ "not_flag": "kebab_done" }, { "before": "04:30" }] },
      { "task": "sq_ets",        "from": "Ets",       "text": "mul on uus kiisunali. ma ei saa seda telefonis rääkida. see on näost näkku nali", "if": [{ "not_flag": "met_ets" }] },
      { "task": "sq_kardo",      "from": "Kardo",     "text": "ma olen kaine ja mul on igav. leia mind üles", "if": [{ "not_flag": "met_kardo" }] },
      { "task": "sq_jaan",       "from": "Jaan",      "text": "Tere! Helista mulle enne kella kolme, mul on sulle üks tähelepanek prootonite kohta.", "if": [{ "before": "02:30" }] },
      { "task": "sq_torta",      "from": "Tundmatu number", "text": "raekoja platsil on öökondiiter. osta sealt tort. ära küsi miks.", "if": [{ "not_flag": "truuse_arrested" }, { "not_item": "torta" }], "weight": 0.6 },
      { "task": "sq_jasper_site","from": "Jasper",    "text": "kuule mul on sulle üks lugu objektist rääkida. see on pikk. leia mind üles" },
      { "task": "sq_jasper_home","from": "Rein (Jasperi töödejuhataja)", "text": "Tere. Jasper peab kell 7.00 objektil olema. Kui sa teda näed, saada ta koju magama. Aitäh. Rein", "if": [{ "after": "01:30" }, { "before": "04:00" }, { "not_flag": "jasper_sent_home" }], "weight": 1.5 },
      { "task": "sq_annu",       "from": "Annu",      "text": "noormees. kui sul suitsu on, tule Rüütlile. mul on sulle maailmast midagi öelda", "if": [{ "item": "cigs" }, { "not_flag": "met_annu" }] },
      { "task": "sq_mart_peace", "from": "Märt",      "text": "kus ain on. ma tean et sa tead", "if": [{ "flag": "met_ain" }, { "not_flag": "mart_peace" }, { "not_flag": "enc_r_mart_vs_ain" }] },
      { "task": "sq_round",      "from": "Poisid (grupp)", "text": "Ain: kelle kord on ringi teha\nMartin: mitte minu\nTristan: sinu kord", "if": [{ "not_flag": "bought_round" }] },
      { "task": "sq_ain_money",  "from": "Jasper",    "text": "ma pean teadma kust aini raha tuleb. aita mul välja uurida", "if": [{ "not_flag": "ain_money_known" }] },
      { "task": "casino_up",     "from": "Janno",     "text": "BROOO!!! KASIINO!!! leia mind üles ja me läheme. full send", "if": [{ "before": "04:00" }, { "not_flag": "casino_up" }] },
      { "task": "charger_find",  "from": "Jasper",    "text": "kas keegi mu laadijat on näinud. valge. natuke kõver. emotsionaalne väärtus", "if": [{ "not_flag": "charger_returned" }] },
      { "task": "group_photo3",  "from": "Kardo",     "text": "teeme täna lõpuks korraliku grupipildi. vähemalt kolm inimest peal. ma olen kaine, ma vastutan kvaliteedi eest", "if": [{ "not_flag": "group_photo3" }] },
      { "task": "milk_home",     "from": "Ema",       "text": "Too homme hommikuks piima, kui koju tuled. Ära unusta. Ma tean, et sa unustad.", "weight": 0.7 }
    ]
  },

  // Skoor lõpus. "points" = ühekordne, "count" + "per" = muutuja (või main_done, side_done, friends_like, all_main) korda punktid.
  "score": [
    { "label": "Jõudsid koju",                          "points": 100, "if": [{ "flag": "home" }] },
    { "label": "Põhiülesanne",                          "count": "main_done", "per": 50 },
    { "label": "Kõik põhiülesanded tehtud",             "count": "all_main", "per": 100, "show_count": false },
    { "label": "Kõrvalülesanne",                        "count": "side_done", "per": 25 },
    { "label": "Blackout, aga koju ilma politseita",    "points": 50, "if": [{ "flag": "blackout" }, { "flag": "home" }, { "not_visited": "police_bench" }] },
    { "label": "Tristan saadetud turvaliselt koju",     "points": 50, "if": [{ "flag": "sent_tristan_home" }] },
    { "label": "Jasper jõudis kell 7 objektile",        "points": 30, "if": [{ "flag": "jasper_sent_home" }] },
    { "label": "Kasiinos number 7",                     "points": 75, "if": [{ "flag": "casino_seven" }] },
    { "label": "Märt ja Ain lepitatud",                 "points": 25, "if": [{ "flag": "mart_peace" }] },
    { "label": "Võitsid kakluse",                       "points": 20, "if": [{ "flag": "won_fight" }] },
    { "label": "Kohtasid Kermot",                       "points": 15, "if": [{ "flag": "met_kermo" }] },
    { "label": "TORTA",                                 "points": 30, "if": [{ "flag": "truuse_arrested" }] },
    { "label": "Video „TORTA“",                         "points": 20, "if": [{ "flag": "filmed_torta" }] },
    { "label": "Kalle (koonus) jõudis koju",            "points": 20, "if": [{ "item": "cone" }, { "flag": "home" }] },
    { "label": "Hea karma",                             "points": 15, "if": [{ "flag": "good_karma" }] },
    { "label": "Sõber, kes sind sallib",                "count": "friends_like", "per": 10 },
    { "label": "Kohatud sõber",                         "count": "friends_met", "per": 5 },
    { "label": "Raha alles (€)",                        "count": "money", "per": 1, "if": [{ "flag": "home" }] },
    { "label": "Akut alles (%)",                        "count": "phone", "per": 0.5, "if": [{ "flag": "home" }] },
    { "label": "Kodus enne 04:00",                      "points": 25, "if": [{ "flag": "home" }, { "before": "04:00" }] },
    { "label": "Kõndisid koju, takso ei näinud sind",   "points": 20, "if": [{ "flag": "home" }, { "not_flag": "took_taxi" }] },
    { "label": "Halb karma",                            "points": -15, "if": [{ "flag": "bad_karma" }] },
    { "label": "Kardo pidi sind päästma",               "count": "kardo_saves", "per": -10 },
    { "label": "Sõber pidi su takso kinni maksma",      "points": -10, "if": [{ "flag": "friend_taxi" }] },
    { "label": "Probleemiriba läks lõhki",              "points": -25, "if": [{ "flag": "meltdown" }] },
    { "label": "Ärkasid politsei ees pingil",           "points": -50, "if": [{ "visited": "police_bench" }] },
    { "label": "Kinni peetud",                          "points": -100, "if": [{ "ending": "detained" }] },
    { "label": "Röövitud",                              "points": -50, "if": [{ "ending": "robbed" }] },
    { "label": "Ukse taha jäänud",                      "points": -25, "if": [{ "ending": "locked_out" }] },
    { "label": "Päike tõusis enne, kui koju jõudsid",   "points": -100, "if": [{ "ending": "sunrise" }] }
  ],

  // Takso hinnatabel: kasutatakse esimest rida, mille "until" on hilisem kui praegune kellaaeg.
  "taxi": {
    "prices": [
      { "until": "02:00", "min": 4.4,  "max": 6.0 },
      { "until": "03:30", "min": 6.0,  "max": 10.0 },
      { "until": "05:00", "min": 10.0, "max": 15.0 },
      { "until": "23:59", "min": 15.0, "max": 21.0 }
    ],
    "surge_chance": 0.15,
    "surge_mult": [1.3, 1.8],
    "wait": [5, 20],
    "ride_minutes": 8,
    // Raha otsas? Küsi poistelt. tõenäosus = base + per_affinity * (kui palju poisid sind kokku sallivad)
    "friend_help": { "base": 0.15, "per_affinity": 0.07 }
  },

  // Pakutakse igas asukohas peale kodu.
  "global_actions": [
    { "label": "Saada Jasper koju magama (kell 7 on objekt)", "show_if": [{ "task": "sq_jasper_home" }, { "not_flag": "jasper_sent_home" }, { "friend_here": "jasper" }],
      "do": [{ "time": 5 }, { "chance": { "var": "aff_jasper", "from": 0, "to": 5, "min": 0.4, "max": 0.95 },
        "then": [{ "flag": "jasper_sent_home" }, { "log": "Saatsid Jasperi koju magama, sest tal oli kell 7 objekt." }, { "say": "Jasper ohkab: „Rein saatis su, eks?“ Ta kallistab sind ja kõnnib koju. Ukse pealt laulab ta veel ühe rea." }],
        "else": [{ "say": "Jasper: „Üks laul veel.“ See on alati üks laul veel. Proovi hiljem uuesti." }] }] },
    { "label": "Tee poistele ring välja (12 €)", "show_if": [{ "task": "sq_round" }, { "not_flag": "bought_round" }, { "present_min": 2 }],
      "if": [{ "var": "money", ">=": 12 }], "locked": "Raha ei jätku",
      "do": [{ "time": 5 }, { "money": -12 }, { "problem": -8 }, { "add": { "drinks": 1 } }, { "flag": "bought_round" }, { "log": "Tegid poistele ringi välja." },
             { "say": "Sa tood ringi. Poisid vaatavad sind nagu kangelast. Kangelaseks olemine maksab täna 12 eurot." }] },
    { "label": "Tee grupipilt kõigiga, kes siin on", "show_if": [{ "task": "group_photo3" }, { "not_flag": "group_photo3" }, { "present_min": 3 }],
      "if": [{ "var": "phone", ">": 0 }], "locked": "Telefon on tühi",
      "do": [{ "time": 5 }, { "phone": -3 }, { "flag": "group_photo3" }, { "log": "Tegid Kardo nõutud grupipildi. Kolm või rohkem inimest, null head nurka." },
             { "say": "Kõik mahuvad pildile. Keegi ei vaata kaamerasse, kellelgi on õlu näos. Kardo kiidab heaks: „Kvaliteet.“" }] },
    { "label": "Anna Kardole Red Bull ja pirukas", "show_if": [{ "item": "kardo_snack" }, { "friend_here": "kardo" }],
      "do": [{ "remove_item": "kardo_snack" }, { "flag": "fed_kardo" }, { "aff": { "kardo": 3 } }, { "problem": -5 },
             { "log": "Tõid kainele Kardole Red Bulli ja piruka. Ta ütles, et sa oled ainuke, kes kuulab." },
             { "say": "Kardo vaatab pirukat nagu medalit. „Sa oled ainus, kes kunagi midagi päriselt toob.“ Ta sööb selle kolme suutäiega ära." }] },
    { "label": "Otsi üles keegi poistest, kes sulle takso telliks",
      "show_if": [{ "var": "money", "<": 6 }, { "not_at": ["kaubamaja", "police_bench"] }],
      "if": [{ "var": "friends_met", ">=": 1 }],
      "locked": "Sa pole täna veel ühtegi poistest näinud",
      "do": [{ "time": [10, 20] },
             { "chance": 0.15, "per_var": "aff_total", "per": 0.07,
               "then": [{ "say": "{friend} ohkab, avab Bolti ja tellib sulle sõidu. „Oled mulle võlgu.“" }, { "friend_taxi": true }],
               "else": [{ "say": "Teed täisringi. Kedagi pole. Või nad peidavad end sinu eest." }] }] }
  ],

