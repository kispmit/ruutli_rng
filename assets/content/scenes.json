               { "say": "Kardo vaatab pirukat nagu medalit. „Sa oled ainus, kes kunagi midagi päriselt toob.“ Ta sööb selle kolme suutäiega ära." }] },
      { "label": "Aja niisama juttu", "do": [{ "time": 10 }, { "problem": -10 }, { "aff": { "kardo": 1 } }, { "random": [
