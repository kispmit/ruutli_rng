      { "label": "Proovi teda rahustada", "next": "truuse_torta_2", "do": [{ "time": 5 }, { "problem": 8 },
        { "say": "„Truuse, see on lihtsalt sõna.“ Truuse, juba katusel: „SEE EI OLE LIHTSALT SÕNA. SEE ON TORTA.“" }] },
      { "label": "Karju kaasa: „TORTA!“", "next": "truuse_torta_2", "do": [{ "time": 5 }, { "problem": 15 }, { "aff": { "truuse": 2 } },
        { "say": "Teie hääled kajavad mööda Rüütli tänavat. Kuskil süttivad aknad. Keegi helistab kuskile." }] },
      { "label": "Filmi kõike", "if": [{ "var": "phone", ">": 0 }], "locked": "Telefon on tühi", "next": "truuse_torta_2",
        "do": [{ "phone": -4 }, { "flag": "filmed_torta" }, { "say": "Video kestab neli minutit. Selle pealkiri on „TORTA“. Hommikuks on sel 12 000 vaatamist." }] },
      { "label": "„KARDO! Tee midagi!“", "show_if": [{ "friend_here": "kardo" }], "next": "truuse_torta_2",
        "do": [{ "aff": { "kardo": 1 } }, { "say": "Kardo karjub: „TRUUSE! TULE ALLA!“ Truuse karjub vastu: „TORTA!“ Esimest korda elus kaotab Kardo vaidluse." }] }
    ]
  },
  {
    "id": "truuse_torta_2", "speaker": "POLITSEI",
    "text": "Sinised tuled. Kaks politseinikku vaatavad bussipeatuse katusele, kus Truuse seisab nagu kuju ja laulab sõna „torta“ erinevatel helikõrgustel. „Härra, tulge alla.“ Truuse: „Ainult tortaga.“",
    "choices": [
      { "label": "Seleta politseile, et see on lihtsalt kook", "do": [{ "time": 15 }, { "problem": 10 },
        { "flag": ["truuse_arrested", "away_truuse"] }, { "remove_item": "torta" }, { "met": "truuse" },
        { "log": "Truuse arreteeriti, sest keegi ütles „torta“. Ta ei kahetse midagi." },
        { "say": "„Kook?“ küsib politseinik. Truuse karjub katuselt: „TORTA EI OLE KOOK!“ Teda viiakse autosse. Akna tagant kostab vaikselt veel üks kord: „torta.“" }] },
      { "label": "Vaata vaikselt pealt", "do": [{ "time": 10 },
        { "flag": ["truuse_arrested", "away_truuse"] }, { "remove_item": "torta" }, { "met": "truuse" },
        { "log": "Vaatasid pealt, kuidas Truuse torta pärast arreteeriti." },
        { "say": "Truuse tuuakse alla nagu kass puu otsast. Politseinik võtab tõendina kaasa ka torti, kui see sul oli. Kaarna saadab sulle ühe sõna: „miks“." }] },
      { "label": "Jookse minema", "do": [{ "time": 5 }, { "problem": 12 },
        { "flag": ["truuse_arrested", "away_truuse"] }, { "met": "truuse" },
        { "log": "Jooksid minema, kui Truuse torta pärast arreteeriti. Truuse ei tea sellest. Veel." },
        { "say": "Sa jooksed nurga taha. Selja tagant kostab viimast korda „TORTAAAA“ ja auto uks paugub kinni. Vaikus." }] }
    ]
  },
  {
    "id": "call_truuse_jail", "speaker": "TRUUSE (KONGIST)",
    "text": "Truuse vastab sosinal: „Mul on üks kõne. Ma valisin sinu. Siin on üks tüüp, kes ütleb, et ta on ka torta pärast sees. Me oleme nüüd bestied.“",
    "choices": [
      { "label": "„Kas sul on kõik hästi?“", "do": [{ "phone": -2 }, { "aff": { "truuse": 1 } }, { "say": "Truuse: „Mul on parem kui kunagi varem. Nad andsid mulle teki. Tekil on muster. See muster on... ei. Ma ei ütle.“" }] },
