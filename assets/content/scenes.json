  // ================================================================ JASPER: ehitusmees, kes laulab
  {
    "id": "j_site", "speaker": "JASPER",
    "text": "Jasperil on käed nagu kaks kinnast, mis on tehtud liivapaberist. „Valasime täna Raadil vundamenti. Kuus tundi järjest. Laulmine on hobi, kutt. Betoon on elu.“ Tal on teksadel ikka veel tsemendiplekid.",
    "choices": [
      { "label": "„Miks sa siis üldse laulma hakkasid?“", "do": [{ "time": 10 }, { "problem": -8 }, { "aff": { "jasper": 2 } }, { "flag": "jasper_backstory" },
        { "say": "„Objektil läks raadio katki. Kolm kuud vaikust ja segumasin. Siis hakkasin ise laulma. Töödejuhataja Rein ütles, et kui ma lõpetan, siis ta vallandab mu.“ Jasper naeratab. „Nüüd laulan iga päev tellingutel. Kuueteistkümnendal korrusel on parim akustika.“" }] },
      { "label": "„Näita, kuidas telliseid laotakse.“", "do": [{ "time": 10 }, { "problem": -6 }, { "aff": { "jasper": 1 } },
        { "say": "Jasper ehitab joogialustest kahe minutiga täiesti sirge seina. Baarman tuleb vaatama. Keegi plaksutab. Jasper lammutab selle ühe liigutusega ja ütleb: „Vundament oli vale.“" }] },
      { "label": "„Mis su elu moto on?“", "do": [{ "aff": { "jasper": 1 } }, { "problem": -5 },
        { "say": "Jasper vaatab sulle sügavalt silma ja ütleb rahulikult: „Situn, nikun, keevitan.“ Siis koputab sulle õlale. „Selles järjekorras. Ära kunagi aja järjekorda segi.“" }] },
      { "label": "„Mida sa praegu ehitad?“", "do": [{ "time": 5 }, { "aff": { "jasper": 1 } }, { "flag": "jasper_backstory" },
        { "say": "„Viiekorruseline maja Raadil. Kolmanda korruse nurgakorter on minu oma. Mitte päriselt. Aga ma panin sinna seina sisse kirja. Mitte keegi ei tea, mis seal on.“ Ta ei ütle sulle ka." }] },
      { "label": "Jätka oma teed", "do": [{ "met": "jasper" }] }
    ]
  },
