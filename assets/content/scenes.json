  // ================================================================ KERMO (3% Rüütlil)
  {
    "id": "kermo", "speaker": "KERMO", "music": "audio/amb/chinese.ogg",
    "on_enter": [{ "flag": "met_kermo" }],
    "text": "Kuskilt hakkab mängima Hiina klassikaline muusika. Keegi ei tea, kust. Sinu ette astub mees nimega Kermo, käed selja taga, pilk kaugel horisondil. Ta vaatab sulle otsa ja ütleb aeglaselt, iga sõna rõhutades: „China will not fire the first shot. But China will not allow you to fire the second shot.“",
    "choices": [
      { "label": "„...Okei?“", "next": "kermo_2", "do": [{ "time": 2 }, { "say": "Kermo noogutab, nagu oleksid sa just midagi väga olulist mõistnud. Sa ei mõistnud. Muusika läheb valjemaks." }] },
      { "label": "„Mis see tähendab, Kermo?“", "next": "kermo_2", "do": [{ "time": 20 }, { "problem": -10 },
