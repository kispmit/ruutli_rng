        { "do": [{ "say": "Kardo: „Tead, mis on kaine olemise parim asi? Ma näen kõiki teie otsuseid. Reaalajas. Kõrgresolutsioonis.“" }] }
      ] }] },
      { "label": "„Toon ära.“", "do": [{ "aff": { "kardo": 1 } }, { "say": "Kardo näitab pöialt. „Pirukas olgu lihapirukas. Ma olen kaine, mitte loll.“" }] },
