      { "label": "„Ain, too parem ring.“", "do": [{ "time": 10 }, { "problem": -10 }, { "add": { "drinks": 1 } }, { "aff": { "ain": 1, "jasper": -1 } },
        { "say": "Ain toob kolm õlut. Keegi ei näinud teda maksmas. Jasper joob oma õlle ära, aga protesti märgiks väga aeglaselt." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }, { "say": "Lahkudes kuuled Jasperit: „...aga MILLAL sa viimati pangas käisid?“" }] }
    ]
  },
  {
    "id": "g_martin_tristan", "speaker": "MARTIN JA TRISTAN", "portrait": "@group",
    "text": "Martin ja Tristan sosistavad. Martin: „Rüütli tänava otsas on liikluskoonus. Oranž. Ilus.“ Tristan: „Ta on üksi. Keegi peab ta koju viima.“ Nad vaatavad sind nagu oleksid sina see keegi.",
    "choices": [
      { "label": "„Olen sees.“", "do": [{ "time": 15 }, { "chance": 0.6,
        "then": [{ "item": "cone" }, { "task_add": "cone_home" }, { "problem": -10 }, { "aff": { "martin": 2, "tristan": 2 } }, { "log": "Varastasid Martini ja Tristaniga liikluskoonuse. Ta on nüüd sinu oma." },
                 { "say": "Operatsioon õnnestub. Sa kõnnid nüüd ringi oranži koonusega. Martin nimetab ta Kalleks. Tristan nutab natuke." }],
        "else": [{ "problem": 18 }, { "aff": { "martin": 1, "tristan": 1 } },
                 { "say": "Kuskilt kostab vile. Te jooksete kolmekesi minema. Tristan kaotab ühe tossu. Koonus jääb oma kohale, üksi ja reedetuna." }] }] },
      { "label": "„Poisid, see on halb mõte.“", "do": [{ "problem": -3 }, { "aff": { "martin": -1, "tristan": -1 } },
        { "say": "Martin: „Kõik head mõtted on alguses halvad.“ Tristan noogutab tõsiselt. Nad lähevad ilma sinuta." }] },
      { "label": "„Ma filmin.“", "if": [{ "var": "phone", ">": 0 }], "locked": "Telefon on tühi",
        "do": [{ "time": 10 }, { "phone": -5 }, { "aff": { "martin": 1, "tristan": 1 } }, { "log": "Filmisid, kuidas Martin ja Tristan koonust varastasid. Video on 4 minutit ja täiesti pime." },
               { "say": "Video on neli minutit pikk. Pildil on ainult pimedus ja Tristani hingeldamine. Martin ütleb, et see on kunst." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_ets_jasper", "speaker": "ETS JA JASPER", "portrait": "@group",
    "text": "Ets räägib Jasperile kiisunalja. Jasper ei naera. Jasper mõtleb. „Aga mida see nali ütleb kassi kohta... kui inimese kohta?“ Ets vaatab sind abi otsides.",
    "choices": [
      { "label": "Naera Etsi nalja üle", "do": [{ "problem": -5 }, { "aff": { "ets": 2, "jasper": -1 } },
        { "say": "Ets osutab sulle: „NÄED? Normaalne inimene NAERAB.“ Jasper ohkab nagu oleks kogu põlvkond ta maha jätnud." }] },
      { "label": "„Jasperil on õigus. Kass on metafoor.“", "do": [{ "time": 15 }, { "problem": -8 }, { "aff": { "jasper": 2, "ets": -1 } },
        { "say": "Te räägite viisteist minutit sellest, kas kass on vaba. Ets lahkub ja tuleb tagasi uue naljaga. Sellest saab samuti metafoor." }] },
      { "label": "„Teeme sellest laulu.“", "do": [{ "time": 20 }, { "problem": -12 }, { "aff": { "jasper": 1, "ets": 1 } },
        { "log": "Kirjutasid Etsi ja Jasperiga laulu „Mjäu-hito (filosoofiline)“." },
        { "say": "Jasper kirjutab viisi, Ets kirjutab sõnad, sina plaksutad. Laul kannab nime „Mjäu-hito (filosoofiline)“. Baarman palub teil lõpetada." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_truuse_jaan", "speaker": "TRUUSE JA JAAN", "portrait": "@group",
    "text": "Truuse: „Emajõgi voolab teisipäeviti tagurpidi.“ Jaan, rahulikult ja veeklaas käes: „See on hüdrodünaamiliselt võimatu. Aga ma kuulan. Mis on sinu andmestik?“ Truuse pole kunagi elus nii tõsiselt võetud olnud.",
    "choices": [
      { "label": "Ole Truuse poolt", "do": [{ "aff": { "truuse": 2, "jaan": -1 } },
        { "say": "Jaan: „Huvitav. Kaks inimest ühe hüpoteesi taga.“ Ta kirjutab midagi salvrätile. Truuse on liigutatud." }] },
      { "label": "Ole Jaani poolt", "do": [{ "aff": { "jaan": 2, "truuse": -1 } },
        { "say": "Truuse: „Te olete mõlemad süsteemi osa.“ Jaan: „Me kõik oleme süsteemi osa. Täpsemalt termodünaamilise süsteemi.“" }] },
      { "label": "Lase neil vaielda ja kuula", "do": [{ "time": [40, 60] }, { "problem": -18 }, { "aff": { "truuse": 1, "jaan": 1 } },
        { "log": "Kuulasid {time} minutit, kuidas Jaan ja Truuse Emajõe voolusuunda arutasid." },
        { "say": "{time} minutit hiljem on salvrätile joonistatud jõgi, neli noolt ja üks hobune. Kokkuleppele ei jõutud, aga mõlemad on õnnelikud." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_janno_ain", "speaker": "JANNO JA AIN", "portrait": "@group",
    "on_enter": [{ "task_add": "casino_up" }, { "flag": "ain_money_known" }],
    "text": "Janno hoiab Ainil õlast: „Ain. Sul ei saa kunagi raha otsa. Mina armastan kasiinot. See on saatus.“ Ain kaalub seda. Andre seisab taamal ja raputab pead.",
    "choices": [
      { "label": "„Lähme kõik kasiinosse!“", "show_if": [{ "before": "05:00" }], "next": "casino",
        "do": [{ "time": 10 }, { "aff": { "ain": 1, "janno": 1 } }, { "met": ["janno", "andre", "ain"] }, { "set": { "casino_net": 0 } }, { "flag": "went_casino" },
               { "say": "Ain tuleb kaasa. Juba uksel ostab ta kõigile žetoone. Kust? Ei tea keegi." }] },
      { "label": "„Ain, ära mine.“", "do": [{ "aff": { "ain": 1, "janno": -1 } },
        { "say": "Ain: „Sul on õigus.“ Janno: „Sul EI OLE õigus!“ Andre, vaikselt: „Tal on õigus.“" }] },
      { "label": "Küsi Ainilt kümme eurot", "do": [{ "money": 10 }, { "aff": { "ain": -1 } },
        { "say": "Ain annab kümme eurot ega küsi neid kunagi tagasi. Ta ei mäleta seda. Rahakotis on tal endiselt täpselt 20 eurot." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_martin_ets", "speaker": "MARTIN JA ETS", "portrait": "@group",
    "text": "Martin ja Ets on keset su ema naljade duelli. Skoor on 7:7. Martin: „Su ema on nii...“ Ets: „Mul on parem.“ Nad pöörduvad sinu poole. „Sina oled kohtunik.“",
    "choices": [
      { "label": "„Martin võitis.“", "do": [{ "aff": { "martin": 2, "ets": -1 } },
        { "say": "Martin tõstab käed nagu oleks kuldmedali saanud. Ets nõuab kordusmängu. Seda ei tule." }] },
      { "label": "„Ets võitis.“", "do": [{ "aff": { "ets": 2, "martin": -1 } },
        { "say": "Ets kummardab. Martin ütleb, et kohtunik on ostetud. Tal pole selle kohta tõendeid, aga hääletoon on veenev." }] },
      { "label": "Viska ise üks su ema nali", "do": [{ "time": 3 }, { "chance": 0.4,
        "then": [{ "problem": -12 }, { "aff": { "martin": 1, "ets": 1 } }, { "say": "Vaikus. Siis naeravad mõlemad. Ets: „Okei. See oli hea.“ Martin: „Ta võttis selle minult.“ Ei võtnud." }],
        "else": [{ "problem": 6 }, { "say": "Mõlemad pöörduvad sinu vastu. Kaks ühe vastu. Su ema saab järgmise viie minuti jooksul kõvasti." }] }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_tristan_janno", "speaker": "TRISTAN JA JANNO", "portrait": "@group",
    "on_enter": [{ "task_add": "casino_up" }],
    "text": "Tristan näitab Jannole pakki Westoneid. Janno särab: „Westonid ja kasiino! Tristan, see on parim plaan, mis kunagi on olnud!“ See ei ole parim plaan.",
    "choices": [
      { "label": "Võta üks Weston", "do": [{ "chance": { "var": "problem", "from": 30, "to": 100, "min": 0.15, "max": 0.8 },
        "then": [{ "log": "Võtsid Tristani ja Janno seltsis ühe Westoni." }, { "blackout": true }],
        "else": [{ "add": { "drinks": 1 } }, { "problem": -10 }, { "aff": { "tristan": 2, "janno": 1 } }, { "say": "Üks Weston. Maailm läheb korraks pehmeks. Janno ütleb, et sa näed välja nagu õnnelik kass." }] }] },
      { "label": "„Lähme kasiinosse!“", "show_if": [{ "before": "05:00" }], "next": "casino",
        "do": [{ "time": 10 }, { "aff": { "tristan": 1, "janno": 1 } }, { "met": ["janno", "andre", "tristan"] }, { "set": { "casino_net": 0 } }, { "flag": "went_casino" }] },
      { "label": "Korja Tristanilt Westonid ära", "do": [{ "aff": { "tristan": -2, "janno": 1 } }, { "problem": -4 },
        { "say": "Tristan annab paki käest nagu kass, kellelt võetakse hiir. Janno: „Vastutustundlik! Sulle meeldib vastutus!“" }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_jasper_jaan", "speaker": "JASPER JA JAAN", "portrait": "@group",
    "text": "Jasper: „Kas universum on lõpmatu?“ Jaan: „Sõltub, mida sa mõtled lõpmatuse all.“ Jasper: „Ma mõtlen... tunnet.“ Jaan paneb veeklaasi lauale. See on alles algus.",
    "choices": [
      { "label": "Löö kaasa", "do": [{ "time": [60, 90] }, { "problem": -25 }, { "aff": { "jasper": 2, "jaan": 2 } },
        { "log": "Arutasid Jasperi ja Jaaniga {time} minutit universumi lõpmatust." },
        { "say": "{time} minutit hiljem on Jasper nutnud kaks korda ja Jaan on joonistanud valguskoonuse. Sa ei tea enam, mis kell on. Universum on lõpmatu. Või mitte." }] },
      { "label": "Suuna jutt tuumafüüsikale", "do": [{ "time": [90, 120] }, { "problem": -30 }, { "flag": "nuclear_talk" }, { "aff": { "jaan": 3, "jasper": -1 } },
        { "log": "Rääkisid Jaaniga {time} minutit tuumafüüsikast. Jasper jäi magama." },
        { "say": "Jaan särab. Jasper jääb kolmanda ristlõike juures istudes magama. {time} minutit hiljem tead, mis on neutronite aeglustamine. Elu ei ole enam endine." }] },
      { "label": "„Poisid, on reede õhtu.“", "do": [{ "aff": { "jasper": -1 } }, { "problem": 3 },
        { "say": "Jaan: „Reede on samuti aegruumi osa.“ Jasper: „Ilus.“ Sa kaotasid." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_ain_martin", "speaker": "AIN JA MARTIN", "portrait": "@group",
    "on_enter": [{ "flag": "ain_money_known" }],
    "text": "Martin küsib Ainilt laenu. Ain annab. Martin küsib uuesti. Ain annab uuesti. Siis pöörab Martin pea sinu poole: „Chief. Sul on ju ka?“",
    "choices": [
      { "label": "Anna Martinile 5 €", "if": [{ "var": "money", ">=": 5 }], "locked": "Raha ei jätku",
        "do": [{ "money": -5 }, { "aff": { "martin": 2 } }, { "flag": "lent_martin" }, { "task_add": "martin_payback" }, { "say": "Martin: „Annan homme tagasi.“ Ain ja sina vaatate teineteisele otsa. Te teate." }] },
      { "label": "„Ain, ta ei maksa sulle kunagi tagasi.“", "do": [{ "aff": { "ain": 1, "martin": -2 } },
        { "say": "Ain kehitab õlgu: „Mul pole vahet. Raha tuleb tagasi.“ Keegi ei tea, kust. Martin vaatab sind nagu reeturit." }] },
      { "label": "Küsi ka ise Ainilt", "do": [{ "money": 5 }, { "aff": { "martin": 1 } },
        { "say": "Ain annab ka sulle viis eurot. Martin tõstab käe high five'iks. Ain ei saa aru, miks ta tunneb end korraga hästi ja halvasti." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_truuse_ets", "speaker": "TRUUSE JA ETS", "portrait": "@group",
    "text": "Truuse ja Ets peavad võistlust: kes räägib kõige uskumatuma loo. Ets räägib nalju. Truuse väidab, et tema räägib ainult tõtt. Skoor on viik.",
    "choices": [
      { "label": "„Truuse võitis.“", "do": [{ "aff": { "truuse": 2, "ets": -1 } },
        { "say": "Truuse: „Sest see kõik on tõsi.“ Ets: „Ka see hobune?“ Truuse: „ERITI see hobune.“" }] },
      { "label": "„Ets võitis.“", "do": [{ "aff": { "ets": 2, "truuse": -1 } },
        { "say": "Ets kummardab. Truuse ütleb, et Etsi naljad on varastatud. Kahjuks on see tõsi." }] },
      { "label": "Räägi ise kõige uskumatum lugu", "do": [{ "time": 10 }, { "chance": 0.5,
        "then": [{ "problem": -12 }, { "aff": { "truuse": 1, "ets": 1 } }, { "log": "Võitsid Truuse ja Etsiga valelugude võistluse." },
                 { "say": "Sinu lugu Toomemäe kummitusest ja Bolti juhist ajab mõlemad vaikseks. Truuse: „Ma usun seda.“ Ets: „Mina ka. Kahjuks.“" }],
        "else": [{ "problem": 5 }, { "say": "Truuse: „Liiga usutav.“ Ets: „Liiga igav.“ Sa kaotasid mõlemale korraga." }] }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_janno_jasper", "speaker": "JANNO JA JASPER", "portrait": "@group",
    "text": "Janno tahab, et Jasper kirjutaks kasiinole hümni. Jasper on sellega juba nõus. Tal on pealkiri olemas: „Maja võidab (aga meie ka)“.",
    "choices": [
      { "label": "Laula kaasa", "do": [{ "time": 10 }, { "problem": -10 }, { "aff": { "janno": 1, "jasper": 1 } },
        { "log": "Laulsid Janno ja Jasperiga kasiinohümni. Kolm salmi, null ilusat nooti." },
        { "say": "Kolm salmi. Refrään on lihtsalt „PUNANE!“ korduvalt. Pool baari laulab lõpuks kaasa." }] },
      { "label": "„Kirjutan ühe salmi: maja võidab alati.“", "do": [{ "aff": { "jasper": 1, "janno": -1 } },
        { "say": "Jasper: „Ausus. Mulle meeldib.“ Janno on korraks kurb. Ainult korraks. Siis on ta jälle õnnelik." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },
  {
    "id": "g_tristan_truuse", "speaker": "TRISTAN JA TRUUSE", "portrait": "@group",
    "text": "Truuse seletab Tristanile, et Westonid tehakse Kalevipoja (hobuse) heinast. Tristan kuulab suurte silmadega. Tristan usub. Tristan usub alati.",
    "choices": [
      { "label": "Kinnita Truuse lugu", "do": [{ "problem": 5 }, { "aff": { "truuse": 2, "tristan": 1 } },
        { "say": "Tristan: „Ma teadsin. Ma TEADSIN, et neis on midagi looduslikku.“ Truuse noogutab nagu teadlane." }] },
      { "label": "„Tristan, ta mõtleb selle välja.“", "do": [{ "aff": { "tristan": 1, "truuse": -2 } },
        { "say": "Truuse: „Kõik suured tõed tunduvad alguses välja mõeldud.“ Tristan on nüüd kahe tõe vahel lõhki." }] },
      { "label": "Osta mõlemale vett (3 €)", "if": [{ "var": "money", ">=": 3 }], "locked": "Raha ei jätku",
        "do": [{ "money": -3 }, { "problem": -6 }, { "aff": { "tristan": 1, "truuse": 1 } },
               { "say": "Vesi. Hüdratatsioon. Kuskil kaugel tunneb Jaan väikest uhkust." }] },
      { "label": "Jäta nad omavahele", "do": [{ "met": "@group" }] }
    ]
  },

