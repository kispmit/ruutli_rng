        { "do": [{ "problem": 6 }, { "say": "Rein: „Kes see on?“ Sina: „Jasperi advokaat.“ Rein paneb toru ära. Jasper vaatab sind nagu kangelast. Homme on tal probleeme." }] },
        { "do": [{ "problem": -5 }, { "flag": "jasper_sent_home" }, { "say": "Rein on täiesti normaalne mees. Ta palub viisakalt, et sa Jasperi koju saadaksid. Sa saadad. Jasper on pettunud, aga täna öösel magab." }] }
