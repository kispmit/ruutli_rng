        { "say": "Jaan: „Sellel on kerge kloori noot.“ Kardo: „Ja pikk järelmaitse.“ Sa jood kolm klaasi ja oled elus nagu ammu mitte." }] },
      { "label": "Küsi Jaanilt tuumafüüsikast", "do": [{ "time": [90, 120] }, { "problem": -30 }, { "flag": "nuclear_talk" }, { "aff": { "jaan": 3 } },
